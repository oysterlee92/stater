{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Spring Boot 애플리케이션의 프론트엔드 리소스 및 빌드 도구",
  "type": "module",
  "author": "oyster",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "watch": "vite build --watch --mode staging",
    "test:resume": "node --experimental-vm-modules --test test/resume/*.test.js",
    "sass:build": "sass public/scss/style.scss public/css/style.css --no-source-map",
    "sass:watch": "sass public/scss/style.scss public/css/style.css --watch --no-source-map"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "lodash": "^4.18.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@vitejs/plugin-legacy": "^8.2.3",
    "fast-glob": "^3.3.3",
    "sass": "^1.106.1",
    "terser": "^5.51.2"
  }
}
